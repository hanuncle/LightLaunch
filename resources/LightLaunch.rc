#include <windows.h>
#include <winver.h>

#include "LightLaunchVersion.h"

1 RT_MANIFEST "LightLaunch.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION LIGHTLAUNCH_VERSION_COMMA
 PRODUCTVERSION LIGHTLAUNCH_VERSION_COMMA
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "LightLaunch Contributors\0"
            VALUE "FileDescription", "LightLaunch lightweight application launcher\0"
            VALUE "FileVersion", LIGHTLAUNCH_VERSION_STRING "\0"
            VALUE "InternalName", "LightLaunch\0"
            VALUE "OriginalFilename", "LightLaunch.exe\0"
            VALUE "ProductName", "LightLaunch\0"
            VALUE "ProductVersion", LIGHTLAUNCH_VERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
